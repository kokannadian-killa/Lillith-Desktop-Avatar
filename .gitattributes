# Git LFS for heavy art (sprite sheets, pose stills, video frames, reference sheets).
# Run `git lfs install` once before adding files under assets/.
assets/**/*.png  filter=lfs diff=lfs merge=lfs -text
assets/**/*.jpg  filter=lfs diff=lfs merge=lfs -text
assets/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
assets/**/*.webp filter=lfs diff=lfs merge=lfs -text
assets/**/*.gif  filter=lfs diff=lfs merge=lfs -text
assets/**/*.mp4  filter=lfs diff=lfs merge=lfs -text
assets/**/*.webm filter=lfs diff=lfs merge=lfs -text
assets/**/*.wav  filter=lfs diff=lfs merge=lfs -text
assets/**/*.ogg  filter=lfs diff=lfs merge=lfs -text
assets/**/*.flac filter=lfs diff=lfs merge=lfs -text
assets/**/*.gguf filter=lfs diff=lfs merge=lfs -text

# Text config stays as normal text
*.toml text eol=lf
*.rs   text eol=lf
*.js   text eol=lf
*.md   text eol=lf
master.zip filter=lfs diff=lfs merge=lfs -text

# Windows scripts
*.bat text eol=crlf
*.ps1 text eol=crlf

# Python sidecar (attachments + bots backend) is dev/source only: keep it out of
# release/source archives (git archive, GitHub "Download ZIP").
tools/lillith-py export-ignore
