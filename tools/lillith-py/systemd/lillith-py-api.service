[Unit]
Description=lillith-py bot API for the Bots tab (loopback only; port from config.toml [sidecar] port, default 8765)
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/lillith-bot serve --host 127.0.0.1
Restart=on-failure
# local-only: block everything but loopback
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=default.target
