# shellcheck shell=bash
post_install() {
  cat <<'MSG'
==> Lillith is installed. Per user (no root needed):
    - Point her at your local model (nothing is downloaded):
        lillith setup --gguf ~/path/to/model.gguf --llama-server /usr/bin/llama-server
    - Window perching on Plasma 6: enable the KWin script once
        kwriteconfig6 --file kwinrc --group Plugins --key lillith-bridgeEnabled true
        qdbus6 org.kde.KWin /KWin reconfigure
    - Desktop icon / autostart: Lillith Settings > Window, or ./linux/install.sh
    - App icon: Lillith Settings > Icon, or: lillith icon --list / lillith icon <id>
    - QuantumSec user units (not enabled): systemctl --user enable --now lillith-quantumsec.service
    - Biotek data home: ~/.biotek (created on first QuantumSec tick)
MSG
}

post_upgrade() {
  echo "==> Restart Lillith (and re-toggle the KWin script) to use the new version."
}
